{
  "name": "fameverse-live",
  "private": true,
  "version": "0.2.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check:lines": "node scripts/check-line-limits.mjs",
    "check:presence": "node scripts/check-live-presence.mjs",
    "check:algorithm": "node scripts/check-verse-momentum.mjs",
    "check:taps": "node scripts/check-tap-integrity.mjs",
    "check:ux": "node scripts/check-live-ux.mjs",
    "check:discovery": "node scripts/check-discovery-ux.mjs",
    "check:identity": "node scripts/check-live-identity.mjs",
    "check:cohost-gifter": "node scripts/check-cohost-gifter.mjs",
    "build": "npm run check:lines && npm run check:presence && npm run check:taps && npm run check:algorithm && npm run check:ux && npm run check:discovery && npm run check:identity && npm run check:cohost-gifter && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
